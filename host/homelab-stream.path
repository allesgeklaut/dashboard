[Unit]
Description=HOMELAB//CTRL stream request spool watcher
# Triggers stream-handler.service when the dashboard container queues
# an up/down request by creating a .request file in the spool dir.

[Path]
# NOTE: %h is NOT used here — in the system manager it resolves to /root,
# not to the User= of the triggered unit. Hardcode the dashboard user's home.
PathExistsGlob=/home/johannes/.homelab-ctrl/stream-spool/*.request
Unit=homelab-stream.service

[Install]
WantedBy=multi-user.target
