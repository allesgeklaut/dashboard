# HOMELAB//CTRL Environment Variables
# Copy this to .env and fill in your values

# ── Portainer (Docker/Podman) ────────────────────────────────────────────────
PORTAINER_URL=
PORTAINER_API_KEY= # My account → Access tokens (Docker: /opt/secrets/portainer.env)
# Optional local-development path to ONE trusted self-signed server certificate.
# With no pin, normal system/Requests CA and hostname verification is required.
# Docker mounts /opt/secrets/portainer-ca.pem and sets its container path.
PORTAINER_CA_FILE=

# Optional: restrict to specific endpoint IDs (leave empty for auto-discovery)
# PORTAINER_ENVS=

# ── AdGuard Home ────────────────────────────────────────────────────────────
ADGUARD_URL=
ADGUARD_USER=
ADGUARD_PASS= # Your AdGuard Home admin password (or API token if using token-based auth)

# ── Shelly Plugs (Energy Tracking) ──────────────────────────────────────────
SHELLY_PLUG_URL=
SHELLY_PLUG_2_URL=

# ── Storage Mounts ───────────────────────────────────────────────────────────
NFS_MOUNTS=/mnt/nas,/mnt/data  # Comma-separated list of NFS mount points to monitor

# ── Host Identity ────────────────────────────────────────────────────────────
# The web container runs on a docker bridge, so it can't see the host's
# hostname/LAN IP. Set these to what the header chips should display.
SYS_HOST_NAME=pop-os
SYS_HOST_IP=192.168.0.46

# ── llama.cpp servers (Llama card) ──────────────────────────────────────────
# The card probes llama-server, llama-bolt, then llama-companion (normally
# only one runs at a time) and shows whichever instance responds. Set any or
# all; leave all empty to hide the card.
LLAMA_SERVER_URL= # e.g. http://192.168.0.46:8084
LLAMA_BOLT_URL= # e.g. http://192.168.0.46:8085
LLAMA_COMPANION_URL= # e.g. http://192.168.0.46:8086

# ── Ollama (model list) ──────────────────────────────────────────────────────
OLLAMA_URL= # e.g. http://192.168.0.46:11434 — leave empty to hide the card

# ── OpenCode Go usage (AI Services tab) ──────────────────────────────────────
# Shows the Go plan's rolling 5h / weekly / monthly usage without expanding
# anything; only the allowances table defaults to collapsed. The card stays
# hidden unless a key is configured. In the container set this to the same
# token the CLI uses — on the server you can read it from the auth store with:
#   python3 -c "import json;print(json.load(open('$HOME/.local/share/opencode/auth.json'))['opencode-go']['key'])"
# During local development this can stay empty — the card then reads
# ~/.local/share/opencode/auth.json directly (override via OPENCODE_AUTH_FILE).
OPENCODE_GO_API_KEY=

# ── AI Services — LiteLLM inventory and benchmark cache ──────────────────────
# LiteLLM config used for the AI Services inventory. The dashboard exports only
# model_name, litellm_params.model, and model_info.mode; credentials and other
# route parameters are never exposed. Relative paths resolve from the server
# process cwd. Leave empty to omit the inventory.
LITELLM_CONFIG_FILE=
# Optional host path override for docker-compose.yml (default: ../litellm/config.yaml).
# Docker requires this existing config file; only that file is mounted read-only.
# LITELLM_CONFIG_HOST_PATH=../litellm/config.yaml
# Optional versioned per-source benchmark snapshot path. Defaults to
# ~/.homelab-ctrl/benchmarks.json; Compose uses /data/benchmarks.json on the
# existing ~/.homelab-ctrl:/data volume. A legacy Artificial Analysis cache is
# not imported or reused.
# HOMELAB_BENCH_FILE=/home/your-user/.homelab-ctrl/benchmarks.json
# Harbor Terminal-Bench 4 and Epoch ECI are fetched by default. LiveBench 2.0
# (release 20261025, seven suites) is opt-in. The original 2024 dataset's Apache
# licence does not conclusively establish the newer score feed's reuse terms.
# Review for your use; private single-user use is this install's operator choice,
# not a legal guarantee. Disabled sources are omitted from the dropdown.
# https://github.com/LiveBench/LiveBench/issues/558 — do not copy tasks.
HOMELAB_LIVEBENCH_ENABLED=false
# Optional DeepSWE source (default off). The artifact has no express license;
# the project repository's Apache-2.0 license covers original contributions and
# curation, but does not explicitly license the website leaderboard artifact.
# Cite Datacurve 2026 (Wenqi Huang, Charley Lee, Leonard Tng, Serena Ge) and do
# not copy tasks or training data.
# The API preserves Epoch AI's warning that at least 23 of 113 v1.1 tasks have
# grading defects: https://epoch.ai/benchmarks/deepswe/review
# Current undated results remain API-only; the table has no summary score.
HOMELAB_DEEPSWE_ENABLED=false

# ── Security watch report (SECURITY tab, read-only) ──────────────────────────
# Directory containing latest.json; empty disables the tab. Docker sets it to
# /run/security-watch. Locally, point it at an existing or synthetic directory.
SECURITY_REPORT_DIR=
# Compose-only host path read-only at /run/security-watch. Default:
# ${HOME}/.local/state/security-watch. Set in this repo's .env or Compose shell,
# not /opt/secrets/dashboard.env. The directory must already exist.
# SECURITY_REPORT_HOST_PATH=/home/your-user/.local/state/security-watch

# ── Steam Streaming (Stream Deck controls) ───────────────────────────────────
# Path of the request spool dir inside the container. Set = feature enabled.
# Compose defaults it to /stream-spool; set STREAM_SPOOL_DIR= (empty) here to
# disable the feature. Must match the host-side spool dir bind-mounted in
# docker-compose.yml, and requires the host-side setup from SETUP.md (§ Steam streaming).
STREAM_SPOOL_DIR= # e.g. /stream-spool

# ── Desktop control (Wake-on-LAN + remote power off) ─────────────────────────
# MAC of the desktop to wake — feature is enabled when this is set. The magic
# packet is broadcast by the host-side spool handler (SETUP.md § 6), not by
# the container: a docker bridge can't deliver directed broadcasts.
WOL_DESKTOP_MAC= # e.g. aa:bb:cc:dd:ee:ff
# IP of the desktop for the UP/OFF status probe (TCP to :22). Optional.
WOL_DESKTOP_IP= # e.g. 192.168.1.50
# Optional broadcast address (default 255.255.255.255) and UDP port (9) —
# read by the host-side wake handler, not by the container.
# WOL_BROADCAST=192.168.1.255
# WOL_PORT=9
# Path of the desktop request spool dir inside the container. Set = wake +
# poweroff enabled. Compose defaults it to /desktop-spool; requires host-side
# setup from SETUP.md (§ Desktop control).
DESKTOP_SPOOL_DIR= # e.g. /desktop-spool
# ssh target of the desktop, read by the server-side power handler. Keep it in
# the server's gitignored .env — real device identifiers never go in git.
DESKTOP_SSH= # e.g. johannes@192.168.1.50
