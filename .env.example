# HOMELAB//CTRL Environment Variables
# Copy this to .env and fill in your values

# ── Portainer (Docker/Podman) ────────────────────────────────────────────────
PORTAINER_URL=
PORTAINER_API_KEY= # Your Portainer API key from Settings → API & Webhooks

# Optional: restrict to specific endpoint IDs (leave empty for auto-discovery)
# PORTAINER_ENVS=

# ── AdGuard Home ────────────────────────────────────────────────────────────
ADGUARD_URL=
ADGUARD_USER=
ADGUARD_PASS= # Your AdGuard Home admin password (or API token if using token-based auth)

# ── Shelly Plugs (Energy Tracking) ──────────────────────────────────────────
SHELLY_PLUG_URL=
SHELLY_PLUG_2_URL=

# ── Storage Mounts ───────────────────────────────────────────────────────────
NFS_MOUNTS=/mnt/nas,/mnt/data  # Comma-separated list of NFS mount points to monitor

# ── Host Identity ────────────────────────────────────────────────────────────
# The web container runs on a docker bridge, so it can't see the host's
# hostname/LAN IP. Set these to what the header chips should display.
SYS_HOST_NAME=pop-os
SYS_HOST_IP=192.168.0.46

# ── llama.cpp servers (Llama card) ──────────────────────────────────────────
# The card probes llama-server, llama-bolt, then llama-companion (normally
# only one runs at a time) and shows whichever instance responds. Set any or
# all; leave all empty to hide the card.
LLAMA_SERVER_URL= # e.g. http://192.168.0.46:8084
LLAMA_BOLT_URL= # e.g. http://192.168.0.46:8085
LLAMA_COMPANION_URL= # e.g. http://192.168.0.46:8086

# ── Ollama (model list) ──────────────────────────────────────────────────────
OLLAMA_URL= # e.g. http://192.168.0.46:11434 — leave empty to hide the card

# ── OpenCode Go usage (opencode go card) ─────────────────────────────────────
# Shows the Go plan's rolling 5h / weekly / monthly usage. The card stays
# hidden unless a key is configured. In the container set this to the same
# token the CLI uses — on the server you can read it from the auth store with:
#   python3 -c "import json;print(json.load(open('$HOME/.local/share/opencode/auth.json'))['opencode-go']['key'])"
# During local development this can stay empty — the card then reads
# ~/.local/share/opencode/auth.json directly (override via OPENCODE_AUTH_FILE).
OPENCODE_GO_API_KEY=

# ── Mistral model benchmark table (optional) ─────────────────────────────────
# Enables the MISTRAL tab for local development when set to the existing
# LiteLLM config YAML. Relative paths resolve from the server process cwd.
LITELLM_CONFIG_FILE=
# Optional host path used by docker-compose.mistral.yml (default: ../litellm/config.yaml).
# This must point to the existing config file; only that file is mounted read-only.
# LITELLM_CONFIG_HOST_PATH=../litellm/config.yaml

# ── Steam Streaming (Stream Deck controls) ───────────────────────────────────
# Path of the request spool dir inside the container. Set = feature enabled.
# Compose defaults it to /stream-spool; set STREAM_SPOOL_DIR= (empty) here to
# disable the feature. Must match the host-side spool dir bind-mounted in
# docker-compose.yml, and requires the host-side setup from SETUP.md (§ Steam streaming).
STREAM_SPOOL_DIR= # e.g. /stream-spool

# ── Desktop control (Wake-on-LAN + remote power off) ─────────────────────────
# MAC of the desktop to wake — feature is enabled when this is set. The magic
# packet is broadcast by the host-side spool handler (SETUP.md § 6), not by
# the container: a docker bridge can't deliver directed broadcasts.
WOL_DESKTOP_MAC= # e.g. aa:bb:cc:dd:ee:ff
# IP of the desktop for the UP/OFF status probe (TCP to :22). Optional.
WOL_DESKTOP_IP= # e.g. 192.168.1.50
# Optional broadcast address (default 255.255.255.255) and UDP port (9) —
# read by the host-side wake handler, not by the container.
# WOL_BROADCAST=192.168.1.255
# WOL_PORT=9
# Path of the desktop request spool dir inside the container. Set = wake +
# poweroff enabled. Compose defaults it to /desktop-spool; requires host-side
# setup from SETUP.md (§ Desktop control).
DESKTOP_SPOOL_DIR= # e.g. /desktop-spool
# ssh target of the desktop, read by the server-side power handler. Keep it in
# the server's gitignored .env — real device identifiers never go in git.
DESKTOP_SSH= # e.g. johannes@192.168.1.50
